# Optional local overrides: the dev stack starts without this file, on the
# fixtures in compose.yaml. Copy it to `.env` to override any value below.
#
# Compose reads `.env` only from the directory of the compose file it runs,
# which is why dev overrides live here and production ones in deploy/.env.

# ---------------------------------------------------------------------------
# WEB PUSH (VAPID)
# ---------------------------------------------------------------------------
# The only variables with no default: without them push is disabled and the
# rest of the app runs. Generate a pair for this machine, never reuse production's:
#   docker compose exec backend python -c "from py_vapid import Vapid01; v=Vapid01(); v.generate_keys(); print(v.public_key_urlsafe_base64(), v.private_key_urlsafe_base64())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=contact@mariam.app

# ---------------------------------------------------------------------------
# MULTI-TENANT
# ---------------------------------------------------------------------------
# Organization served when the host carries no subdomain, as on localhost.
DEFAULT_ORG_SLUG=demo
