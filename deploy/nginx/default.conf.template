# One origin for both containers, so the browser needs no CORS:
# /v1 and /health go to the Flask backend, everything else to the Node frontend.

# In front of Flask's own limits, not instead of them. A 10m zone holds about
# 160,000 addresses.
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;
# Public pages: one campus reaches us through a single NAT address, so this zone
# budgets a whole school, not a visitor. Cloudflare absorbs volumetric attacks.
limit_req_zone $binary_remote_addr zone=public_limit:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=2r/s;
limit_req_zone $binary_remote_addr zone=health_limit:10m rate=5r/s;

server {
    listen 80 default_server;
    # Wildcard tenant hosting: every *.mariam.app subdomain (organization) is
    # served by this block; the Host is forwarded to the backend for resolution.
    server_name _;

    # The origin only sees Cloudflare's IPs; restore the real visitor IP so that
    # nginx rate limiting (and access logs) key on the client, not on Cloudflare.
    # Ranges from https://www.cloudflare.com/ips/ (keep in sync).
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    set_real_ip_from 2400:cb00::/32;
    set_real_ip_from 2606:4700::/32;
    set_real_ip_from 2803:f800::/32;
    set_real_ip_from 2405:b500::/32;
    set_real_ip_from 2405:8100::/32;
    set_real_ip_from 2a06:98c0::/29;
    set_real_ip_from 2c0f:f248::/32;
    real_ip_header CF-Connecting-IP;
    # $remote_addr is now the real client, and the proxy_set_header lines below
    # rebuild both forwarding headers from it. Passing the client's own copies
    # through would let anyone reaching the origin directly forge the address
    # that Flask rate-limits and counts on.

    # Names are looked up at each request: a recreated container may come back on
    # another address.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $backend http://backend:5000;
    set $frontend http://frontend:3000;

    # Must match Flask's MAX_CONTENT_LENGTH, or nginx answers 413 to an upload
    # the backend would accept.
    client_max_body_size 32m;

    gzip on;
    gzip_min_length 1000;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css application/json application/javascript application/x-javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml application/wasm application/manifest+json font/ttf font/woff font/woff2;

    location = /health {
        limit_req zone=health_limit burst=10 nodelay;
        limit_req_status 429;

        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header CF-Connecting-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /v1/auth {
        limit_req zone=auth_limit burst=5 nodelay;
        limit_req_status 429;

        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header CF-Connecting-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /v1/public {
        limit_req zone=public_limit burst=60 nodelay;
        limit_req_status 429;

        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header CF-Connecting-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /v1 {
        limit_req zone=api_limit burst=20 nodelay;
        limit_req_status 429;

        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header CF-Connecting-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass $frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header CF-Connecting-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
