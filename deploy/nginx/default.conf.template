# One origin for the API and the pages, so the browser needs no CORS.

server {
    listen 80 default_server;
    # Any host: the services behind resolve the organization from it.
    server_name _;

    # Names are looked up at each request: a recreated container may come back on
    # another address.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
    set $backend http://backend:5000;
    set $frontend http://frontend:3000;

    # Must match Flask's MAX_CONTENT_LENGTH, or nginx answers 413 to an upload
    # the backend would accept.
    client_max_body_size 32m;

    gzip on;
    gzip_min_length 1000;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css application/json application/javascript application/x-javascript text/xml application/xml application/xml+rss text/javascript image/svg+xml application/wasm application/manifest+json font/ttf font/woff font/woff2;

    # Rebuilt from $remote_addr, the visitor as conf.d/client-address.conf
    # establishes it, so a client cannot choose the address behind. A location
    # that sets a proxy_set_header of its own inherits none of these.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;

    location = /health {
        proxy_pass $backend;
    }

    location /health/ {
        proxy_pass $backend;
    }

    location /v1 {
        proxy_pass $backend;
    }

    location / {
        proxy_pass $frontend;
    }
}
