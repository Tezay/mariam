# Production environment. Copy to '.env' and replace every CHANGE_ME value.
# The backend refuses to start if a required secret is missing or left at a
# development default.
#
# Generate random keys with:
#   openssl rand -hex 32

# ----------------------------------------
# POSTGRESQL
# ----------------------------------------
POSTGRES_USER=mariam
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_32_CHARS
POSTGRES_DB=mariam_db

# ----------------------------------------
# FLASK BACKEND
# ----------------------------------------
SECRET_KEY=CHANGE_ME_RANDOM_64_CHARS
JWT_SECRET_KEY=CHANGE_ME_ANOTHER_RANDOM_64_CHARS

# Restaurant workstations are shared, so sessions are deliberately short.
JWT_ACCESS_TOKEN_MINUTES=30

# Shown in authenticator apps next to the account.
MFA_ISSUER_NAME=MARIAM

# Fernet key encrypting TOTP secrets at rest. Losing it makes every stored
# secret unreadable and forces an MFA reset for all accounts — back it up.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# Public URL of the client. Also the CORS allow-list; accepts a comma-separated
# list when several domains serve the app.
FRONTEND_URL=http://localhost

# Where the links of an email reach the API. Empty means FRONTEND_URL/v1, which
# this compose file serves. When the API has a host of its own, give the value
# the front end is given: https://api.example.org/v1. That host stays on the
# site of the pages (api.example.org beside www.example.org): a browser keeps no
# session cookie for an API on another site.
API_URL=

# ----------------------------------------
# S3 STORAGE
# ----------------------------------------
# Any S3-compatible provider. Uploaded media is served straight from the bucket,
# never through Flask, so S3_PUBLIC_URL must be reachable by visitors.
S3_ENDPOINT_URL=https://s3.example.com
S3_ACCESS_KEY_ID=CHANGE_ME_S3_ACCESS_KEY
S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET_KEY
S3_BUCKET_NAME=mariam-uploads
S3_REGION=CHANGE_ME_REGION
S3_PUBLIC_URL=https://mariam-uploads.s3.example.com

# ----------------------------------------
# REDIS
# ----------------------------------------
# Carries the JWT blocklist, the rate-limit counters shared between Gunicorn
# workers, the analytics cache, the traffic counters and the job locks. Defaults
# to the bundled service; a managed instance (rediss://…) works unchanged.
# Required: the backend and the scheduler refuse to start without it.
REDIS_URL=redis://redis:6379/0

# ----------------------------------------
# ANALYTICS
# ----------------------------------------
# Cache lifetime of the dashboard aggregates, in seconds. 0 disables it.
ORG_CACHE_TTL_SECONDS=60

# Request budget for the public pages, per IP address. A whole campus reaches
# the app through a single address, so this covers a school at lunchtime rather
# than one visitor. Raise it for a very large site.
PUBLIC_RATE_LIMIT=600 per minute

TELEMETRY_ENABLED=1

# 13 months, so a period can be compared with the same period a year earlier.
TELEMETRY_RETENTION_DAYS=400

# Audit entries carry the acting account's IP address and browser, so they are
# kept to the window a security investigation needs, not longer.
AUDIT_RETENTION_DAYS=180

# Counter inflation caps, per site and per day. IP addresses serve these caps
# alone, hashed with the daily salt.
TELEMETRY_VISITOR_DAILY_CAP=120
# Per-address caps. A campus shares one address, so these must stay far above a
# school's real traffic or legitimate views are dropped. Raise them for a very
# busy site; never lower them without measuring first.
TELEMETRY_IP_DAILY_CAP=50000
TELEMETRY_IP_UNIQUE_CAP=5000

# ----------------------------------------
# MENU VOTE
# ----------------------------------------
#
# Signs the anonymous device tokens the vote widget carries. Must differ from
# JWT_SECRET_KEY: sharing one would let a leak of either forge both. Rotating it
# invalidates every device token, so students may vote once more that day.
DEVICE_ID_SECRET=CHANGE_ME_RANDOM_64_CHARS

# New votes accepted from one IP address per organization and day; changing an
# existing vote is free, since it cannot move the score. A campus votes from a
# single address, so this bounds a scripted flood, not a person - the device
# token is what limits an individual.
VOTE_IP_DAILY_CAP=3000
# New device tokens issued to one address per hour. Sized for a whole school
# arriving at lunch, not for one visitor.
VOTE_DEVICE_MINT_PER_HOUR=2000

# ----------------------------------------
# ALERTS
# ----------------------------------------
# Thresholds of the live alerts shown in the bell. Each rule can be switched
# off per user; these values decide when it has something to say.
# Days without any recorded action before a site is called inactive.
ALERT_INACTIVE_DAYS=7
# A traffic drop is only reported above this daily average, and when yesterday
# falls under this share of the four previous same weekdays.
ALERT_MIN_VIEWS=50
ALERT_TRAFFIC_DROP_PCT=0.5
# Votes required before satisfaction or vote anomalies are judged, the weekly
# score under which satisfaction is reported, and the votes-per-visitor ratio
# above which a day looks forged.
ALERT_MIN_VOTES=30
ALERT_LOW_SCORE=1.8
ALERT_VOTE_ANOMALY_RATIO=1.5

# ----------------------------------------
# EMAIL (weekly digest)
# ----------------------------------------
# Left empty, every send is a logged no-op: the product works without mail.
# Any relay accepting STARTTLS on 587; the sender domain needs SPF, DKIM and DMARC.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=Mariam <no-reply@mail.mariam.app>
# Where a reply to an email goes, and the contact its footer gives. Left empty,
# emails name no contact and a reply to the sender is lost.
SUPPORT_EMAIL=
SMTP_TLS=1
# Folder read under app/templates/emails/ for the wording.
EMAIL_LOCALE=fr

# ----------------------------------------
# WEBAUTHN / PASSKEYS
# ----------------------------------------
# RP ID is the public domain without scheme or port; Origin is the full URL.
# A mismatch makes passkey registration and login fail.
WEBAUTHN_RP_ID=mariam.app
WEBAUTHN_RP_NAME=MARIAM
WEBAUTHN_ORIGIN=https://mariam.app

# ----------------------------------------
# WEB PUSH (VAPID)
# ----------------------------------------
# Changing the pair after deployment invalidates every existing subscription:
# users have to re-enable notifications.
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE_KEY
VAPID_CONTACT_EMAIL=contact@mariam.app

# ----------------------------------------
# UMAMI
# ----------------------------------------
# Optional. Both are needed for the tracker to load: the address of its script
# and the site it reports as. Empty loads nothing.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

# ----------------------------------------
# MAP
# ----------------------------------------
# Optional. The tiles of the map on a site's page, with {z}, {x} and {y}, and the
# credit they require. Empty shows the address without a map. For the Plan IGN:
# MAP_TILE_URL=https://data.geopf.fr/wmts?SERVICE=WMTS&REQUEST=GetTile&VERSION=1.0.0&LAYER=GEOGRAPHICALGRIDSYSTEMS.PLANIGNV2&STYLE=normal&TILEMATRIXSET=PM&FORMAT=image/png&TILEMATRIX={z}&TILEROW={y}&TILECOL={x}
# MAP_TILE_ATTRIBUTION=© IGN – Plan IGN
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=

# ----------------------------------------
# PROXY
# ----------------------------------------
# The visitor's address is read from REAL_IP_HEADER (empty: X-Forwarded-For), on
# connections from TRUSTED_PROXIES only (comma-separated ranges; empty: the
# private ones). Behind a CDN that puts the visitor's address in a header of its
# own, name that header.
TRUSTED_PROXIES=
REAL_IP_HEADER=

# ----------------------------------------
# MULTI-TENANT
# ----------------------------------------
# The subdomain in front of BASE_DOMAIN is the organization slug
# (crous-creteil.mariam.app resolves to the 'crous-creteil' organization).
BASE_DOMAIN=mariam.app
# Organization served when the host matches no subdomain. Empty means 404.
DEFAULT_ORG_SLUG=
# Hostname this deployment must be reached on. Set it on the old hostname during
# a migration: the app then unregisters its service worker and redirects itself.
CANONICAL_HOST=

# ----------------------------------------
# DEPLOYMENT
# ----------------------------------------
# The release every image runs, such as 0.20.0. Rolling back is setting the
# previous one.
MARIAM_TAG=CHANGE_ME_VERSION
# Override the image prefix if the repository changes owner or name.
# BACKEND_IMAGE=ghcr.io/tezay/mariam-backend
# FRONTEND_IMAGE=ghcr.io/tezay/mariam-frontend
# PROXY_IMAGE=ghcr.io/tezay/mariam-proxy
# BACKUP_IMAGE=ghcr.io/tezay/mariam-backup

# Size to the server.
GUNICORN_WORKERS=3
GUNICORN_THREADS=4

# ----------------------------------------
# SENTRY (EU region)
# ----------------------------------------
# One DSN per project, backend and frontend. Empty disables reporting.
SENTRY_DSN=
FRONTEND_SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ----------------------------------------
# POSTGRES BACKUPS
# ----------------------------------------
# Bucket and keys: see "Automated off-site backups" in docs/OPERATIONS.md.
BACKUP_S3_ENDPOINT=https://s3.example.com
BACKUP_S3_REGION=CHANGE_ME_REGION
# s3:PutObject only.
BACKUP_S3_ACCESS_KEY=CHANGE_ME_BACKUP_WRITE_ONLY_KEY
BACKUP_S3_SECRET_KEY=CHANGE_ME_BACKUP_WRITE_ONLY_SECRET
BACKUP_S3_BUCKET=mariam-backups
# age public key; the identity stays offline.
BACKUP_AGE_RECIPIENT=CHANGE_ME_AGE_PUBLIC_KEY
# Europe/Paris.
BACKUP_TIME=03:00
# Optional: fetched after each successful backup.
BACKUP_HEARTBEAT_URL=
