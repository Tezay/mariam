# Node runs the build tools and the server; Bun installs the dependencies.
FROM node:22-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS base
COPY --from=oven/bun:1.4.2@sha256:9114c058aeae42162ee16dd5084b95fe9473970bb6bcb5b232ab1630f0546895 /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app
COPY package.json bun.lock ./

FROM base AS builder
RUN bun install --frozen-lockfile
COPY . .
RUN bun run build

FROM base AS runtime-dependencies
RUN bun install --frozen-lockfile --production

FROM node:22-slim@sha256:e9f565d32859f0cbfb52125eafe8be39390f24dac302dc3cdf566e8ba3ab21ee AS runtime

# The base image lags behind the distribution's security fixes.
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000

COPY --from=runtime-dependencies /app/node_modules ./node_modules
COPY --from=builder /app/build ./build
COPY package.json server.js ./

USER node
EXPOSE 3000

# The image carries neither curl nor wget.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["node", "-e", "fetch('http://127.0.0.1:' + process.env.PORT + '/healthz').then((r) => process.exit(r.ok ? 0 : 1), () => process.exit(1))"]

# Last on purpose: this changes at every release and would otherwise invalidate
# the layers above.
ARG APP_VERSION=dev
ENV APP_VERSION=${APP_VERSION}

CMD ["node", "server.js"]
